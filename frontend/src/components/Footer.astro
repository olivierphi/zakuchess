---
// GitHub SVG logo as base64
const githubSvgBase64 =
  "";
---

<footer
  class="w-full text-slate-100 text-sm text-center mt-1 mb-10 md:max-w-xl mx-auto"
>
  <div class="text-center">Made with ❤️ in 🏴󠁧󠁢󠁳󠁣󠁴󠁿</div>

  <div class="text-center mb-3">© 2023-2024 ZakuChess</div>

  <div class="align-middle">
    This web game is open source.
    <a
      href="https://github.com/olivierphi/zakuchess"
      rel="noreferrer noopener"
      target="_blank"
      class="underline hover:no-underline"
    >
      <img
        src={`data:image/svg+xml;base64,${githubSvgBase64}`}
        class="inline-block w-4 aspect-square"
        alt="GitHub logo"
      />
    </a>
  </div>

  <div>
    <a
      href="https://github.com/olivierphi/zakuchess"
      rel="noreferrer noopener"
      target="_blank"
      class="underline hover:no-underline"
    >
      Version 1.0.0
    </a>
  </div>
</footer>
