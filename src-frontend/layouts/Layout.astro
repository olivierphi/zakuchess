---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ModalsContainer from '../components/ModalsContainer.astro';
// Assets:
import '@fontsource-variable/open-sans';
import "../styles/global.css";

interface Props {
	title?: string;
	leftSideButtons?: any[];
	rightSideButtons?: any[];
	headChildren?: any[];
}

const {
	title = "ZakuChess ♞ - A daily chess challenge with pixel art units",
	leftSideButtons,
	rightSideButtons,
	headChildren
} = Astro.props;

const metaDescription = "Play chess with character(s) - a chess game with pixel art units, with a new challenge every day.";
---

<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
	<head>
		<!-- ZakuChess is open source! See https://github.com/olivierphi/zakuchess -->
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={metaDescription} />
		<meta name="keywords" content="chess pixel-art roleplay" />

		<!-- Favicons -->
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content="website" />

		<meta name="generator" content={Astro.generator} />

		<!-- Custom fonts -->
		<style is:global>
			@font-face {
					font-family: "PixelFont";
					src: url("/assets/fonts/fibberish.ttf") format("truetype");
					font-weight: normal;
					font-style: normal;
					font-display: swap;
			}
		</style>


		{headChildren && headChildren.map(child => child)}
	</head>
	<body class="font-sans bg-body-background">
		<Header leftSideButtons={leftSideButtons} rightSideButtons={rightSideButtons} />
		<slot />
		<Footer />
		<ModalsContainer />
	</body>
</html>
